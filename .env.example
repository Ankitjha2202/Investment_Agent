# Copy to .env and fill in values.
# Never commit real secrets.

SERVICE_ROLE_KEY=
ANON_KEY=

# Write connection (ETL, migrations). Prefer Supabase Session pooler URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Read-only connection used for LLM-generated SQL (must not allow writes).
# For now can match DATABASE_URL; replace with a SELECT-only role before production.
DATABASE_URL_READONLY=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Required for embeddings, text-to-SQL, routing, synthesis
OPENAI_API_KEY=
